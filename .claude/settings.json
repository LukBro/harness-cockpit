{
  "env": {
    "MONOLYNX_PROJECT_SLUG": "harness-cockpit",
    "MONOLYNX_BRANCH_MODE": "ticket",
    "MONOLYNX_AUTOTEST": "true",
    "MONOLYNX_AUTOCOMMIT": "true",
    "MONOLYNX_AUTOPUSH": "true",
    "MONOLYNX_AUTOMR": "true",
    "MONOLYNX_CONTRACT": "auto"
  },
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(ruff:*)",
      "Bash(python tools/check_layers.py)",
      "Bash(python3 tools/check_layers.py)",
      "Bash(python tools/mutanty_zmian.py:*)",
      "Bash(python3 */skills/*/scripts/monolynx_op.py *)",
      "Bash(python3 */skills/*/scripts/monolynx_transport.py)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin worktree-HAR-*)",
      "Bash(git push origin worktree-HAR-*)",
      "Bash(git push -u origin retro-*)",
      "Bash(git push -u origin fix-*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr merge * --auto *)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Edit(.claude/agent-memory/**)",
      "Write(.claude/agent-memory/**)",
      "mcp__monolynx"
    ],
    "ask": [
      "Bash(git commit --amend:*)",
      "Bash(pip install:*)",
      "Bash(uv add:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",
      "Bash(git push origin main)",
      "Bash(git push origin master)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh repo:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh workflow:*)",
      "Bash(gh auth login:*)",
      "Bash(gh auth logout:*)",
      "Bash(gh auth token:*)",
      "Bash(gh auth refresh:*)",
      "Bash(gh auth setup-git:*)",
      "Bash(gh auth switch:*)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Write(.claude/settings.local.json)",
      "Edit(.claude/hooks/**)",
      "Write(.claude/hooks/**)",
      "Read(.env)",
      "Read(**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/straz.py\""
          }
        ]
      }
    ]
  }
}
